cytokine_nested_pies <- function(df, anchor) {
# Cytokines
cytokines <- setdiff(colnames(df), anchor)
# Filter IFN+ (anchor-positive) cells
anchor_pos <- df %>% dplyr::filter(!!rlang::sym(anchor)==TRUE)
# Count within IFN+ for the main central pie
central_counts <- anchor_pos %>%
tidyr::pivot_longer(cols = cytokines, names_to="cytokine", values_to="positive") %>%
dplyr::group_by(cytokine) %>%
dplyr::summarise(n = sum(positive)) %>%
dplyr::ungroup()
# Compute layout for pies: central + outer ring
cx <- 0
cy <- 0
r_main <- 1
r_small <- 0.35
angle_step <- 2*pi / length(cytokines)
pie_positions <- tibble::tibble(
cytokine = cytokines,
x = cx + 2.2 * r_main * cos(seq(0, 2*pi - angle_step, length.out = length(cytokines))),
y = cy + 2.2 * r_main * sin(seq(0, 2*pi - angle_step, length.out = length(cytokines)))
)
# Build list of df for each floating pie
outer_pies <- purrr::map_df(cytokines, function(cyt) {
anchor_pos %>%
dplyr::count(positive = .data[[cyt]]) %>%
dplyr::mutate(positive = ifelse(positive, "Positive", "Negative"),
cytokine = cyt)
})
# Plot
ggplot() +
# CENTRAL PIE (composition of IFN+ in terms of other cytokines)
ggforce::geom_arc_bar(
data = central_counts %>%
dplyr::mutate(
start = cumsum(lag(n, default=0))/sum(n) * 2*pi,
end   = cumsum(n)/sum(n) * 2*pi
),
aes(
x0 = cx, y0 = cy, r0 = 0, r = r_main,
start = start, end = end, fill = cytokine
),
color = "white"
) +
# SMALL FLOATING PIES
ggforce::geom_arc_bar(
data = pie_positions %>% dplyr::left_join(outer_pies),
aes(
x0 = x, y0 = y, r0 = 0,
r = r_small,
start = ifelse(positive == "Positive", 0, pi),
end = ifelse(positive == "Positive", pi, 2*pi),
fill = positive
),
color = "white"
) +
coord_fixed() +
scale_fill_manual(values = c(
"Positive" = "#1b9e77",
"Negative" = "#d95f02"
)) +
theme_void() +
ggtitle(paste0("Nested Pie Cytokine Map Anchored on ", anchor))
}
cytokine_nested_pies(df_IFN, anchor = "IFN")
View(central_counts)
